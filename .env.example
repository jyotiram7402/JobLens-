# Copy to .env on a development machine. Never commit the filled-in file.
#
# Used by docker/docker-compose.yml and by the Spring Boot backend.

# Which application profile to run. dev is the default and needs nothing else
# set; prod requires every DB_* value below and has no fallbacks.
SPRING_PROFILES_ACTIVE=dev

# Reported by GET /api/v1/meta so it is obvious which environment you hit.
JOBLENS_ENVIRONMENT=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=joblens
DB_USERNAME=joblens
DB_PASSWORD=change-me-locally
# Provider-specific JDBC extras, e.g. ?sslmode=require for a managed database.
DB_URL_PARAMS=

SERVER_PORT=8080

# Signing key for access tokens. Generate with: openssl rand -base64 48
# Must be at least 32 bytes; the application refuses to start otherwise.
# NEVER commit a real value.
JWT_SECRET=replace-with-a-secure-secret-at-least-32-bytes-long
# How long an access token stays valid. Short, because it cannot be revoked.
JWT_EXPIRATION=1h

# Exact origins allowed to call the API: scheme included, no trailing slash,
# comma-separated for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DEBUG while working on the backend, INFO otherwise.
LOG_LEVEL_JOBLENS=DEBUG
